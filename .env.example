# Base URL for JSON API calls. Default "/api" (proxied by Vite in dev, by public/_redirects on Netlify).
# Set to the backend URL directly if your host cannot proxy and the backend allows your origin.
VITE_API_BASE=/api
# SignalR hub for live match updates (WebSockets). Defaults to the backend directly.
VITE_HUB_URL=https://mrksz-webapp-appserver-od67o.ondigitalocean.app/matchhub
